<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
      name="gz::sim::systems::Physics" />
    <plugin filename="ignition-gazebo-user-commands-system"
      name="gz::sim::systems::UserCommands" />
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster" />
    <!-- 传感器渲染系统：激光雷达/相机都靠它驱动 -->
    <plugin filename="ignition-gazebo-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- 光照：内联，不依赖 Fuel -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面：box 有厚度，物理碰撞正常，小车不会掉下去。
         顶面在 z=0（中心下沉半个厚度 0.05）。 -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 10 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <!-- 雷达离地只有 3.69cm，水平射线会切到地面，在地面矩形
               边界上形成一圈跟随车体移动的“方形假墙”。
               gpu_lidar 只与 visual 求交，因此在这里给地面单独一个
               visibility flag（bit1=2），再在雷达的 visibility_mask 里
               把这个位清掉，雷达就完全看不见地面，而物理碰撞
               （collision）不受任何影响，小车依然不会掉下去。 -->
          <visibility_flags>2</visibility_flags>
          <geometry>
            <box>
              <size>10 10 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- ================= 墙壁与障碍物 ================= -->
    <!-- 房间：10m x 10m，墙高 0.5m、厚 0.1m，围出 [-4.95, 4.95] -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4.95 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <box>
              <size>10 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>10 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.75 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4.95 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <box>
              <size>10 0.1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>10 0.1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.75 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4.95 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <box>
              <size>0.1 10 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>0.1 10 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.75 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-4.95 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <box>
              <size>0.1 10 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>0.1 10 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.75 1</ambient>
            <diffuse>0.7 0.7 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 隔断墙：中间一堵，形成两个房间和一个 1.2m 通道 -->
    <model name="divider_a">
      <static>true</static>
      <pose>-1.5 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <box>
              <size>0.1 6.8 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>0.1 6.8 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="divider_b">
      <static>true</static>
      <pose>-0.5 -1.7 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <box>
              <size>0.1 6.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>0.1 6.0 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.65 1</ambient>
            <diffuse>0.6 0.6 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 圆柱障碍：测试绕障 -->
    <model name="pillar_1">
      <static>true</static>
      <pose>2.0 2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.45 0.3 1</ambient>
            <diffuse>0.85 0.45 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>2.0 -2.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.45 0.3 1</ambient>
            <diffuse>0.85 0.45 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 方块障碍：窄通道测试 -->
    <model name="box_obstacle">
      <static>true</static>
      <pose>-3.0 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="c">
          <geometry>
            <box>
              <size>0.6 0.6 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="v">
          <geometry>
            <box>
              <size>0.6 0.6 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.6 0.85 1</ambient>
            <diffuse>0.3 0.6 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>