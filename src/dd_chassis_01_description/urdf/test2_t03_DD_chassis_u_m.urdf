  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>wheel_l</left_joint>
      <right_joint>wheel_r</right_joint>
      <wheel_separation>0.34</wheel_separation>
      <wheel_radius>0.0325</wheel_radius>
      <max_linear_acceleration>0.5</max_linear_acceleration>
      <topic>cmd_vel</topic>
    </plugin>

    <!-- odom 取自世界真值位姿（Fortress 的 DiffDrive 只能轮速积分，打滑就飘），
         并直接通过 tf_topic 发布 odom -> base_footprint。
         关掉 DiffDrive 自己的 odom，避免与真值 odom 抢同一个话题。 -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <dimensions>2</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
    </plugin>
  </gazebo>
