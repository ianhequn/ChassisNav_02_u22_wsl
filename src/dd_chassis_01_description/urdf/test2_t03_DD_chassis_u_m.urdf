  <!-- 扫描面 link：真实 YDLIDAR 的测距基准面在雷达基座上方 18mm，
       而不是 ydlidar_link 原点（STL 双锥体的正中心）。
       单独建一个无质量 link，让 sensor 挂在这里，好处是：
       - TF 树里 lidar_scan_link 就代表真实扫描面，slam 建图精度正确
       - 不动 ydlidar_link 的位置，RViz 里的模型不会悬空
       fixed 关节会在 URDF->SDF 时被融合，不引入额外自由度。 -->
  <link name="lidar_scan_link" />

  <joint name="lidar_scan_joint" type="fixed">
    <!-- ydlidar joint 有 rpy="1.5708 0 0"（绕X+90°），所以 ydlidar_link 的
         +Y 才对应 base_link 的 +Z（向上）。要抬高扫描面 18mm 必须写 y。 -->
    <origin xyz="0 0.018 0" rpy="-1.5708 0 0" />
    <parent link="ydlidar_link" />
    <child link="lidar_scan_link" />
  </joint>
